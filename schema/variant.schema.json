{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "판 정보 variants/<판>/VARIANT.json",
  "type": "object",
  "required": ["id"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "label": {"type": "string"},
    "summary": {"type": "string"},
    "upstream": {
      "type": "object",
      "properties": {
        "commit": {"type": "string"},
        "date": {"type": "string"}
      }
    },
    "release": {"type": "object"}
  }
}
