{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "[dfr] ready 줄의 JSON",
  "type": "object",
  "required": ["api_version", "worker_version", "variant", "upstream_commit"],
  "properties": {
    "api_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "worker_version": {"type": "string", "minLength": 1},
    "variant": {"type": "string", "minLength": 1},
    "upstream_commit": {"type": ["string", "null"]}
  }
}
